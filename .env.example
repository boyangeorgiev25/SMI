# Copy to .env and fill in. Optional: Google Maps JS API key
# (needs Google Cloud billing). Leave empty to use the free
# OpenStreetMap map instead.
VITE_GOOGLE_MAPS_API_KEY=

# Shared data store (bookings, quiz answers, stats).
# Hosted on Vercel: nothing to set here. api/data.js stores the document in
# Upstash Redis — in the Vercel dashboard open the project → Storage →
# Create Database → Upstash Redis (free) → Connect to project → Redeploy.
# Locally (`npm run dev`) the Vite plugin serves /api/data from data.json.
#
# Optional: point at another JSON endpoint instead, e.g. Firebase Realtime
# Database (console.firebase.google.com → Realtime Database → copy URL and
# append /smi.json; rules {"rules":{".read":true,".write":true}}):
# VITE_DATA_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app/smi.json
# npoint.io URLs are ignored — CDN-cached for an hour and far too slow.
VITE_DATA_URL=
