# Copy to .env and fill in. Optional: Google Maps JS API key
# (needs Google Cloud billing). Leave empty to use the free
# OpenStreetMap map instead.
VITE_GOOGLE_MAPS_API_KEY=

# Shared data store for the hosted site (bookings, quiz answers, stats).
# Without it, data only syncs while `npm run dev` runs on your Mac, and a
# hosted build keeps everything on her phone — the admin view stays empty.
#
# Quickest (no account): open https://www.npoint.io, paste
#   {"attempts":[],"bookings":[],"prizes":[]}
# press Save, and copy the "API" URL it shows, e.g.
# VITE_DATA_URL=https://api.npoint.io/0123456789abcdef0123
# Don't press "Lock" on npoint — the site must be able to write to it.
#
# Alternative: Firebase Realtime Database (Google account, ~3 min) —
# console.firebase.google.com → Build → Realtime Database → Create (test mode)
# → copy the URL and append /smi.json, e.g.
# VITE_DATA_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app/smi.json
# then set rules to {"rules":{".read":true,".write":true}} (test mode expires in 30 days).
#
# Anyone with the URL can read/write the data, so don't share it.
# Rebuild (npm run build) after changing it — it's baked into the build.
VITE_DATA_URL=
